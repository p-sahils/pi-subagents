{
  "default": "deny",
  "deny": [
    { "command": "pwd", "unlessArgs": [], "reason": "pwd takes no arguments here" },
    { "command": "find", "predicate": "find-dangerous-flag" },
    { "command": "rg", "predicate": "rg-dangerous-flag" },
    { "command": "python", "unlessArgsPrefix": ["-m", "pytest"], "reason": "only python -m pytest is allowed" },
    { "command": "python3", "unlessArgsPrefix": ["-m", "pytest"], "reason": "only python -m pytest is allowed" },
    { "command": "git", "predicate": "git-readonly-risky-flag" },
    { "command": "gh", "predicate": "gh-non-pr", "reason": "only gh pr commands are allowlisted" }
  ],
  "ask": [
    { "command": "*", "hasAnyArg": ["--no-verify"], "reason": "bypasses configured hooks" },
    { "command": "*", "hasAnyArg": ["--force", "--force-with-lease", "-f"], "reason": "force option" },
    { "command": "pre-commit", "unlessArgsPrefix": ["run"], "reasonTemplate": "pre-commit {subcommand} may execute or modify project hooks" },
    { "command": ["npm", "pnpm", "yarn"], "subcommands": ["test", "run", "exec", "dlx"], "reasonTemplate": "package manager script/execution: {subcommand}" },
    { "command": ["npm", "pnpm", "yarn"], "subcommands": ["install", "add", "remove", "uninstall", "update", ""], "reasonTemplate": "package manager mutation: {subcommandOr:install}" },
    { "command": "git", "predicate": "git-branch-mutating", "reason": "git branch arguments can create, move, or delete branches" },
    { "command": "git", "predicate": "git-push-delete-ref", "reason": "git push can delete a remote ref" },
    { "command": "git", "argsPrefix": ["reset"], "hasAnyArg": ["--hard"], "reason": "git reset --hard discards local changes" },
    { "command": "git", "predicate": "git-clean-removes-files", "reason": "git clean can remove untracked files" },
    { "command": "git", "predicate": "git-checkout-overwrite", "reason": "git checkout -- can overwrite working tree files" },
    { "command": "git", "predicate": "git-restore-discard", "reason": "git restore can discard local changes" },
    { "command": "git", "subcommands": ["filter-branch", "filter-repo"], "reason": "git history rewrite" },
    { "command": "gh", "predicate": "gh-pr-edit-body-file", "reason": "GitHub PR metadata edit via --body-file" }
  ],
  "allow": [
    { "command": "pwd", "args": [] },
    { "command": ["ls", "find", "rg", "grep", "pytest", "gt"] },
    { "command": ["python", "python3"], "argsPrefix": ["-m", "pytest"] },
    { "command": "pre-commit", "argsPrefix": ["run"] },
    { "command": "git" },
    { "command": "gh", "argsPrefix": ["pr"], "subcommands": ["view", "status", "checks", "create"], "subcommandIndex": 1 }
  ]
}
